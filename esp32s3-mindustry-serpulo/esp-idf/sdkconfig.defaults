# ESP-IDF sdkconfig.defaults для прототипа mindserpulo (ESP32-S3 N16R8)
# N16R8 = 16 МБ flash (QIO) + 8 МБ PSRAM (Octal, 80 МГц)

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM: структура сектора (~1.4 МБ) живёт здесь
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Если плата без PSRAM — не падать на старте, а сообщить в лог
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Логирование
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# Тик FreeRTOS 1000 Гц — точнее шаг симуляции (30 Гц)
CONFIG_FREERTOS_HZ=1000

# Больше стека главной задаче: отрисовки нет, но есть вложенные вызовы симуляции
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
