# Keep GitHub's primary-language detection on Java.
#
# Mindustry's in-game "Mods -> Import -> Import from GitHub" decides
# between downloading the release jar and downloading a branch archive
# by looking at the repository language reported by the GitHub API
# (ModsDialog.githubImportMod in v160.7: only Java/Kotlin/Groovy/Scala
# repos take the release-jar path). The script version under scriptmod/
# is an alternative build of the same mod, not the project's primary
# language, so it is excluded from language statistics.
scriptmod/** linguist-documentation=true

# Built ZIPs are binary release artifacts.
dist/*.zip binary
minecraft-vanilla/dist/*.zip binary
minecraft-xray-resourcepack/dist/*.zip binary
