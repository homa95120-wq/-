{
  "name": "esp32-web-ide",
  "version": "1.0.0",
  "description": "VS Code-style browser IDE for ESP32 (MicroPython) via Web Serial",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.cjs",
    "app": "npm run build && electron .",
    "app:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "keywords": [],
  "author": {
    "name": "ESP32 Studio",
    "email": "esp32studio@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esptool-js": "^0.7.0",
    "monaco-editor": "^0.57.0"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "ru.esp32studio.app",
    "productName": "ESP32 Studio",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ESP32 Studio"
    },
    "portable": {
      "artifactName": "ESP32-Studio-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "resources/icon.png",
      "maintainer": "esp32studio@users.noreply.github.com"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png"
    },
    "publish": null
  }
}