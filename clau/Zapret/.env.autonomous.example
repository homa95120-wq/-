# ========================================================
# АВТОНОМНОЕ ДВИЖЕНИЕ — КОНФИГУРАЦИЯ
# ========================================================
# Добавьте эти настройки в ваш .env файл
# Копируйте только нужные параметры

# --------------------------------------------------------
# Включение автономного движения
# --------------------------------------------------------

# Включить автономное движение (0 = выключено, 1 = включено)
# По умолчанию выключено для безопасности
RC_AUTO_NAV_ENABLE=1

# --------------------------------------------------------
# Параметры дороги
# --------------------------------------------------------

# Ширина дороги в метрах
# Диапазон: 3.0-15.0 метров
# По умолчанию: 7.5
RC_ROAD_WIDTH_M=7.5

# Безопасное расстояние от края дороги в метрах
# Робот не будет подъезжать к краю ближе этого расстояния
# Диапазон: 0.3-2.0 метров
# По умолчанию: 0.8
RC_SAFE_DISTANCE_M=0.8

# --------------------------------------------------------
# Параметры движения
# --------------------------------------------------------

# Скорость исследования в м/с
# ВАЖНО: Начинайте с малых значений!
# Диапазон: 0.02-0.15 м/с
# По умолчанию: 0.08
# Рекомендуется для первых тестов: 0.05
RC_AUTO_NAV_SPEED_MPS=0.08

# Интервал обновления сканирования в секундах
# Чем меньше значение, тем быстрее реакция, но выше нагрузка
# Диапазон: 0.2-2.0 секунд
# По умолчанию: 0.5
RC_SCAN_INTERVAL_S=0.5

# Угол поворота колёс при обходе препятствий (градусы)
# Диапазон: 15.0-90.0 градусов
# По умолчанию: 30.0
# Меньше значение = плавнее повороты
RC_TURN_ANGLE_DEG=30.0

# --------------------------------------------------------
# Настройки камер
# --------------------------------------------------------

# Порт левой камеры (передняя левая)
# Обычно /dev/video0
# Проверка: ls -l /dev/video*
RC_CAMERA_FRONT=/dev/video0

# Порт правой камеры (передняя правая)
# Обычно /dev/video1
RC_CAMERA_REAR=/dev/video1

# --------------------------------------------------------
# Дополнительные параметры (опционально)
# --------------------------------------------------------

# Габариты робота для навигации

# Радиус описанной окружности робота (м)
# Используется для планирования безопасного пути
# По умолчанию: 0.42
RC_NAV_FOOTPRINT_M=0.42

# Длина робота (м)
# По умолчанию: 0.75
RC_ROBOT_LENGTH_M=0.75

# Ширина робота (м)
# По умолчанию: 0.60
RC_ROBOT_WIDTH_M=0.60

# Высота робота (м)
# По умолчанию: 0.30
RC_ROBOT_HEIGHT_M=0.30

# Смещение лидара от переднего края (м)
# По умолчанию: 0.35
RC_LIDAR_OFFSET_M=0.35

# --------------------------------------------------------
# Настройки качества и безопасности
# --------------------------------------------------------

# Минимальное качество локализации для движения (0.0-1.0)
# По умолчанию: 0.55 (55%)
RC_NAV_QUALITY_MIN=0.55

# Максимальный возраст скана лидара (секунды)
# По умолчанию: 1.0
RC_NAV_SCAN_AGE_S=1.0

# Допуск достижения точки маршрута (метры)
# По умолчанию: 0.14
RC_NAV_WAYPOINT_TOLERANCE_M=0.14

# --------------------------------------------------------
# ВАЖНО: КАЛИБРОВКА СКОРОСТИ
# --------------------------------------------------------
# Эти параметры нужно измерить на вашем роботе!
# Без правильной калибровки автономное движение не будет работать

# Скорость в м/с на 1% тяги
# Измерьте: засеките время и расстояние при известной тяге
# Пример: Если при 10% робот проехал 5 метров за 10 секунд:
# Скорость = 5м / 10с = 0.5 м/с при 10%
# На 1% = 0.5 / 10 = 0.05 м/с
# ОБЯЗАТЕЛЬНО НАСТРОЙТЕ!
RC_NAV_MPS_PER_PERCENT=0.01

# Базовая скорость навигации (м/с)
# Используется существующей системой навигации
RC_NAV_SPEED_MPS=0.05

# Максимальный процент тяги
# По умолчанию: 4% (очень консервативно для безопасности)
RC_NAV_MAX_PERCENT=4

# --------------------------------------------------------
# Примеры конфигураций для разных сценариев
# --------------------------------------------------------

# === КОНСЕРВАТИВНАЯ (безопасная для первых тестов) ===
# RC_AUTO_NAV_ENABLE=1
# RC_ROAD_WIDTH_M=7.5
# RC_SAFE_DISTANCE_M=1.2
# RC_AUTO_NAV_SPEED_MPS=0.05
# RC_SCAN_INTERVAL_S=0.5
# RC_TURN_ANGLE_DEG=20.0

# === СТАНДАРТНАЯ (рекомендуемая) ===
# RC_AUTO_NAV_ENABLE=1
# RC_ROAD_WIDTH_M=7.5
# RC_SAFE_DISTANCE_M=0.8
# RC_AUTO_NAV_SPEED_MPS=0.08
# RC_SCAN_INTERVAL_S=0.5
# RC_TURN_ANGLE_DEG=30.0

# === БЫСТРАЯ (после успешных тестов) ===
# RC_AUTO_NAV_ENABLE=1
# RC_ROAD_WIDTH_M=7.5
# RC_SAFE_DISTANCE_M=0.8
# RC_AUTO_NAV_SPEED_MPS=0.12
# RC_SCAN_INTERVAL_S=0.3
# RC_TURN_ANGLE_DEG=30.0

# === УЗКАЯ ДОРОГА (3-5 метров) ===
# RC_AUTO_NAV_ENABLE=1
# RC_ROAD_WIDTH_M=4.0
# RC_SAFE_DISTANCE_M=0.5
# RC_AUTO_NAV_SPEED_MPS=0.06
# RC_SCAN_INTERVAL_S=0.4
# RC_TURN_ANGLE_DEG=25.0

# === ШИРОКАЯ ДОРОГА (10+ метров) ===
# RC_AUTO_NAV_ENABLE=1
# RC_ROAD_WIDTH_M=12.0
# RC_SAFE_DISTANCE_M=1.0
# RC_AUTO_NAV_SPEED_MPS=0.10
# RC_SCAN_INTERVAL_S=0.5
# RC_TURN_ANGLE_DEG=35.0

# --------------------------------------------------------
# Проверка конфигурации
# --------------------------------------------------------
# После настройки запустите:
# python3 scripts/test_autonomous.py --test-full
#
# Для просмотра текущих значений:
# grep "RC_AUTO" .env | grep -v "^#"
